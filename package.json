{
  "name": "@edgez/react-native-sdk",
  "version": "0.1.0",
  "description": "React Native SDK for EdgeZ HaLow mesh devices",
  "license": "Apache-2.0",
  "homepage": "https://github.com/edgez-ai/react-native-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgez-ai/react-native-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/edgez-ai/react-native-sdk/issues"
  },
  "keywords": ["react-native", "bluetooth", "ble", "mesh", "halow", "iot"],
  "publishConfig": {
    "access": "public"
  },
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "files": ["src", "lib", "android/build.gradle", "android/consumer-rules.pro", "android/src", "macos", "windows", "protos", "EdgezReactNativeSdk.podspec", "NuGet.config", "react-native.config.js", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "protobufjs": "^7.5.4"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "^20.0.2",
    "@react-native-community/cli-platform-ios": "^20.0.2",
    "@react-native/babel-preset": "^0.82.0",
    "@react-native/typescript-config": "^0.82.0",
    "@react-native/eslint-config": "^0.82.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "react": "19.1.1",
    "react-native": "0.82.0",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": ["/node_modules/", "/example/"]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [["commonjs", {"esm": true}], "module", "typescript"]
  }
}
